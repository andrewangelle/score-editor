{
  "name": "pdf-editor",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --force --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "format": "pnpm exec biome format . --write",
    "lint": "biome lint",
    "check": "biome check",
    "lint:fix": "pnpm exec biome check . --write",
    "lint:check": "pnpm exec biome check .",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cross-env playwright test --project=chromium",
    "test:e2e:all": "cross-env playwright test",
    "test:e2e:chrome": "cross-env playwright test --project=\"Google Chrome\"",
    "test:e2e:debug": "cross-env playwright test --debug --project=chromium",
    "test:e2e:edge": "cross-env playwright test --project=\"Microsoft Edge\"",
    "test:e2e:firefox": "cross-env playwright test --project=firefox",
    "test:e2e:headed": "cross-env playwright test --headed --ui --project=chromium",
    "test:e2e:report": "playwright show-report",
    "test:types": "pnpm exec tsc --noEmit",
    "test:e2e:ui": "cross-env playwright test --ui",
    "test:e2e:webkit": "cross-env playwright test --project=webkit",
    "test:visual": "cross-env playwright test --project=visual",
    "test:visual:update": "cross-env playwright test --project=visual --update-snapshots",
    "update:tsr": "sh ./scripts/update-tsr.sh"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-router": "^1.170.24",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.41",
    "@tanstack/react-virtual": "^3.14.14",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-pdf": "^10.4.1",
    "react-redux": "^9.3.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "@biomejs/biome": "2.5.7",
    "@netlify/vite-plugin-tanstack-start": "^1.3.17",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/router-cli": "^1.167.41",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxc-transform-react": "^0.145.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "pnpm lint:fix",
      "pnpm format"
    ]
  }
}
